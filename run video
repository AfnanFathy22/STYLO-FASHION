"""
run_video.py
------------
Stage 1 (Body Understanding) + optional Stage 2 (Virtual Try-On) runner
for a SAVED VIDEO FILE (not the live webcam).

It reuses the exact same building blocks as run_image.py:
    PoseEstimator, PersonSegmenter, MeshEstimator
but loops them over every (or every Nth) frame of a video file instead of
a single image.

New on top of run_image.py:
  1. Body-change detection between consecutive processed frames
     (compares pose landmark positions frame-to-frame).
  2. An optional hook that fires a virtual try-on call whenever a
     "significant body change" is detected, so you don't waste time/GPU
     running the diffusion model on every single frame.

Run with:
    python run_video.py --video path/to/clip.mp4

Useful flags:
    --output PATH          custom output folder root
    --process-every N      only run the heavy pose/seg/mesh models every
                            N-th frame (default 1 = every frame). Raise this
                            if the video is slow to process.
    --change-threshold F   average landmark movement (in pixels, normalized
                            0..1 * frame diagonal) needed to count as a
                            "body change". Default 0.03.
    --garment PATH         path to a garment/clothing image. If given AND
                            --tryon is set, try-on is triggered on detected
                            body-change frames.
    --tryon                enable the virtual try-on hook on detected
                            body-change frames.
    --tryon-model {idm,ootd,idm_remote}
                            which try-on engine to use when --tryon is set:
                            'idm'        = local IDM-VTON (needs GPU + detectron2)
                            'ootd'       = local OOTDiffusion (needs GPU)
                            'idm_remote' = IDM-VTON via the free Hugging Face
                                           Space (tryon/idm_vton_remote.py) --
                                           no local GPU/detectron2 needed.
                            Default: idm_remote (works on CPU-only machines).
    --no-display            headless mode: don't open a window, just process
                            and (optionally) save every N-th frame.

Controls in the result window (only when not --no-display):
    SPACE -> pause / resume playback
    S     -> save the current frame's artifacts to disk
    Q     -> quit
"""

import argparse
import os
import sys
import time

import cv2
import numpy as np

import config
from pose.pose_estimator import PoseEstimator
from segmentation.segmenter import PersonSegmenter
from mesh.mesh_estimator import MeshEstimator
from utils import visualization, io_utils

WINDOW_NAME = "Stage 1 - Body Understanding [Video Mode] (SPACE=pause S=save Q=quit)"
TRYON_WINDOW_NAME = "Virtual Try-On Result"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run Stage 1 (pose + segmentation + mesh) on a video file, "
        "with optional body-change-triggered virtual try-on."
    )
    parser.add_argument("--video", type=str, required=True, help="Path to the input video file.")
    parser.add_argument("--output", type=str, default=None, help="Custom output folder root.")
    parser.add_argument(
        "--process-every",
        type=int,
        default=1,
        help="Run the heavy models every N-th frame (default: 1 = every frame).",
    )
    parser.add_argument(
        "--change-threshold",
        type=float,
        default=0.03,
        help="Normalized average landmark movement needed to flag a body change.",
    )
    parser.add_argument(
        "--garment",
        type=str,
        default=None,
        help="Path to a garment image to use for virtual try-on (requires --tryon).",
    )
    parser.add_argument(
        "--tryon",
        action="store_true",
        help="Enable the virtual try-on hook on detected body-change frames.",
    )
    parser.add_argument(
        "--tryon-model",
        type=str,
        choices=["idm", "ootd", "idm_remote"],
        default="idm_remote",
        help="Which virtual try-on engine to use when --tryon is set: "
        "'idm' = local IDM-VTON (tryon/idm_vton_wrapper.py, needs GPU+detectron2), "
        "'ootd' = local OOTDiffusion (tryon/ootd_wrapper.py, needs GPU), "
        "'idm_remote' = IDM-VTON via the free Hugging Face Space "
        "(tryon/idm_vton_remote.py, no local GPU needed). Default: idm_remote.",
    )
    parser.add_argument(
        "--no-display",
        action="store_true",
        help="Headless mode: process the video without opening a display window.",
    )
    parser.add_argument(
        "--max-width",
        type=int,
        default=480,
        help="Downscale each frame to fit within this width (keeping aspect ratio) BEFORE "
        "running pose/segmentation/mesh. Smaller = much faster. Default: 480. Use 0 to disable.",
    )
    parser.add_argument(
        "--max-height",
        type=int,
        default=640,
        help="Same as --max-width but for height -- important for portrait/vertical videos, "
        "which would otherwise stay huge even after width is limited. Default: 640. Use 0 to disable.",
    )
    parser.add_argument(
        "--display-width",
        type=int,
        default=900,
        help="Max width of the on-screen result window (the 2x2 grid of panels). "
        "Default: 900. Use 0 to disable.",
    )
    parser.add_argument(
        "--display-height",
        type=int,
        default=850,
        help="Max height of the on-screen result window. Important for portrait videos. "
        "Default: 850. Use 0 to disable.",
    )
    return parser.parse_args()


def resize_keep_aspect(frame, target_width: int, target_height: int = 0):
    """Resize `frame` to fit WITHIN a (target_width x target_height) box, keeping aspect
    ratio (so both portrait and landscape video are handled correctly). Only ever shrinks,
    never enlarges. Pass target_height=0 to constrain by width only."""
    if target_width <= 0 and target_height <= 0:
        return frame
    h, w = frame.shape[:2]
    scales = []
    if target_width > 0 and w > target_width:
        scales.append(target_width / float(w))
    if target_height > 0 and h > target_height:
        scales.append(target_height / float(h))
    if not scales:
        return frame
    scale = min(scales)
    new_size = (int(round(w * scale)), int(round(h * scale)))
    return cv2.resize(frame, new_size, interpolation=cv2.INTER_AREA)


def open_video(video_path: str) -> cv2.VideoCapture:
    if not os.path.exists(video_path):
        raise FileNotFoundError(
            f"No file found at '{video_path}'. Check the path (use an absolute path "
            "if you're not sure the terminal's current folder matches)."
        )
    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        raise ValueError(
            f"'{video_path}' exists but could not be opened as a video. "
            "Make sure it's a valid, non-corrupted video file and that OpenCV "
            "was built with the right codec support."
        )
    return cap


def landmarks_to_array(pose_result) -> np.ndarray:
    """
    Extract a flat (N, 2) array of normalized (x, y) landmark coordinates
    from a pose_result, for change-detection purposes.

    Assumes pose_result exposes `.landmarks`, a list/iterable of objects or
    tuples with .x / .y (or [0] / [1]) attributes in normalized 0..1 space,
    which is the standard MediaPipe-style convention this project's
    PoseEstimator already follows elsewhere in the codebase. Adjust this
    function if PoseEstimator's actual landmark structure differs.
    """
    if pose_result is None or not getattr(pose_result, "detected", False):
        return None

    points = []
    for lm in pose_result.landmarks:
        if hasattr(lm, "x") and hasattr(lm, "y"):
            points.append((lm.x, lm.y))
        else:
            points.append((lm[0], lm[1]))
    if not points:
        return None
    return np.array(points, dtype=np.float32)


def body_change_score(prev_landmarks: np.ndarray, curr_landmarks: np.ndarray) -> float:
    """
    Average per-landmark displacement between two normalized landmark arrays.
    Returns None if the arrays can't be compared (missing detection, shape mismatch).
    """
    if prev_landmarks is None or curr_landmarks is None:
        return None
    if prev_landmarks.shape != curr_landmarks.shape:
        return None
    diffs = np.linalg.norm(curr_landmarks - prev_landmarks, axis=1)
    return float(np.mean(diffs))


def maybe_run_tryon(frame, garment_path, tryon_enabled, tryon_model, frame_index):
    """
    Thin wrapper around the virtual try-on integration. Dispatches to one of:
        tryon/idm_vton_wrapper.py   (local IDM-VTON, needs GPU + detectron2)
        tryon/ootd_wrapper.py       (local OOTDiffusion, needs GPU)
        tryon/idm_vton_remote.py    (IDM-VTON via free HF Space, no GPU needed)
    depending on `tryon_model`, so all three engines can share this same call
    site and you can switch between them with just the --tryon-model flag.
    """
    if not tryon_enabled or not garment_path:
        return None

    engine_label = {
        "idm": "IDM-VTON (local)",
        "ootd": "OOTDiffusion (local)",
        "idm_remote": "IDM-VTON (remote HF Space)",
    }.get(tryon_model, tryon_model)

    try:
        if tryon_model == "ootd":
            from tryon.ootd_wrapper import run_tryon
        elif tryon_model == "idm_remote":
            from tryon.idm_vton_remote import run_tryon
        else:
            from tryon.idm_vton_wrapper import run_tryon
    except ImportError as exc:
        print(
            f"[TRYON] --tryon was set (model='{tryon_model}') but the matching "
            f"wrapper isn't available yet ({exc}). See tryon/README.md. "
            "Skipping try-on for this frame."
        )
        return None

    try:
        print(f"[TRYON] Body change detected at frame {frame_index}, running {engine_label}...")
        t0 = time.time()
        result = run_tryon(person_image=frame, garment_image_path=garment_path)
        print(f"[TRYON] Done in {time.time() - t0:.1f}s")

        try:
            tryon_dir = os.path.join(config.OUTPUT_DIR, "tryon_results")
            os.makedirs(tryon_dir, exist_ok=True)
            save_path = os.path.join(tryon_dir, f"frame_{frame_index:06d}.jpg")
            cv2.imwrite(save_path, result)
            print(f"[TRYON] Result saved to: {save_path}")
        except Exception as exc:
            print(f"[TRYON][WARNING] Could not save result to disk: {exc}")

        return result
    except Exception as exc:
        print(f"[TRYON][ERROR] {engine_label} try-on failed on frame {frame_index}: {exc}")
        return None


def main() -> int:
    args = parse_args()

    print("=" * 70)
    print("Stage 1: Body Understanding - Video Mode")
    print("=" * 70)

    try:
        cap = open_video(args.video)
    except Exception as exc:
        print(f"[FATAL] {exc}")
        return 1

    fps = cap.get(cv2.CAP_PROP_FPS) or 0
    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
    print(f"Loaded video: {args.video}  (fps: {fps:.1f}, frames: {total_frames or 'unknown'})")
    print("Initializing models (this can take a few seconds on first run)...")

    try:
        pose_estimator = PoseEstimator()
        segmenter = PersonSegmenter()
        mesh_estimator = MeshEstimator()
    except Exception as exc:
        print(f"[FATAL] Failed to initialize models: {exc}")
        return 1

    frame_index = -1
    prev_landmarks = None
    paused = False
    last_display = None
    last_tryon_result = None

    if not args.no_display:
        cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_NORMAL)

    try:
        while True:
            if not paused:
                ok, frame = cap.read()
                if not ok:
                    print("End of video reached.")
                    break
                frame_index += 1
                frame = resize_keep_aspect(frame, args.max_width, args.max_height)

                run_heavy_models = (frame_index % max(args.process_every, 1)) == 0

                if run_heavy_models:
                    try:
                        pose_result = pose_estimator.process(frame)
                    except Exception as exc:
                        print(f"[ERROR] Pose estimation failed on frame {frame_index}: {exc}")
                        pose_result = None

                    try:
                        seg_result = segmenter.process(frame) if pose_result else None
                    except Exception as exc:
                        print(f"[ERROR] Segmentation failed on frame {frame_index}: {exc}")
                        seg_result = None

                    try:
                        mesh = mesh_estimator.build(
                            seg_result.binary_mask if seg_result and seg_result.success else None,
                            pose_result,
                        ) if pose_result else None
                    except Exception as exc:
                        print(f"[ERROR] Mesh estimation failed on frame {frame_index}: {exc}")
                        mesh = None

                    # --- body change detection ---
                    curr_landmarks = landmarks_to_array(pose_result)
                    change = body_change_score(prev_landmarks, curr_landmarks)
                    if change is not None and change >= args.change_threshold:
                        print(f"[CHANGE] Frame {frame_index}: score={change:.4f} (threshold={args.change_threshold})")
                        tryon_result = maybe_run_tryon(frame, args.garment, args.tryon, args.tryon_model, frame_index)
                        if tryon_result is not None:
                            last_tryon_result = tryon_result
                    if curr_landmarks is not None:
                        prev_landmarks = curr_landmarks

                    # --- visualization ---
                    pose_overlay = pose_estimator.draw(frame, pose_result) if pose_result else frame.copy()
                    if seg_result and seg_result.success:
                        segmentation_overlay = segmenter.overlay_mask(frame, seg_result)
                        background_removed = segmenter.remove_background(frame, seg_result)
                    else:
                        segmentation_overlay = frame.copy()
                        background_removed = frame.copy()
                    mesh_overlay = mesh_estimator.draw(frame, mesh) if (mesh and mesh.valid) else frame.copy()

                    panels = {
                        "Pose": pose_overlay,
                        "Segmentation": segmentation_overlay,
                        "Mesh": mesh_overlay,
                        "Background Removed": background_removed,
                    }
                    last_display = visualization.make_panel_grid(panels)
                    last_display = resize_keep_aspect(last_display, args.display_width, args.display_height)

                    # keep the latest results around for the 'S' save handler
                    _last_frame = frame
                    _last_pose_result = pose_result
                    _last_seg_result = seg_result
                    _last_mesh = mesh
                    _last_pose_overlay = pose_overlay
                    _last_segmentation_overlay = segmentation_overlay
                    _last_background_removed = background_removed
                    _last_mesh_overlay = mesh_overlay

            if args.no_display:
                continue

            if last_display is not None:
                cv2.imshow(WINDOW_NAME, last_display)

            if last_tryon_result is not None:
                cv2.imshow(TRYON_WINDOW_NAME, last_tryon_result)

            wait_ms = max(int(1000 / fps), 1) if fps else 30
            key = cv2.waitKey(wait_ms if not paused else 0) & 0xFF

            if key == ord("q") or key == ord("Q"):
                print("Quit requested.")
                break
            elif key == ord(" "):
                paused = not paused
                print("Paused." if paused else "Resumed.")
            elif key == config.KEY_SAVE and last_display is not None:
                try:
                    save_dir = io_utils.save_capture(
                        original_frame=_last_frame,
                        pose_overlay=_last_pose_overlay,
                        segmentation_overlay=_last_segmentation_overlay,
                        binary_mask=_last_seg_result.binary_mask if _last_seg_result and _last_seg_result.success else None,
                        alpha_mask=_last_seg_result.alpha_mask if _last_seg_result and _last_seg_result.success else None,
                        background_removed=_last_background_removed,
                        mesh_overlay=_last_mesh_overlay,
                        mesh=_last_mesh,
                        pose_result=_last_pose_result,
                        output_root=args.output,
                    )
                    print(f"[SAVED] Frame {frame_index} written to: {save_dir}")
                except Exception as exc:
                    print(f"[ERROR] Could not save frame {frame_index}: {exc}")

    finally:
        cap.release()
        cv2.destroyAllWindows()
        pose_estimator.close()
        segmenter.close()
        print("All resources released. Goodbye!")

    return 0


if __name__ == "__main__":
    sys.exit(main())
